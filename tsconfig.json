{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-cms-e2e/types/**/*.ts",
    ".next-cms-e2e/dev/types/**/*.ts",
    ".next-e2e-webpack/types/**/*.ts",
    ".next-e2e-webpack/dev/types/**/*.ts",
    ".next-cms-e2e-webpack/types/**/*.ts",
    ".next-cms-e2e-webpack/dev/types/**/*.ts",
    ".next-cms-e2e-webpack-muq60cib/types/**/*.ts",
    ".next-cms-e2e-webpack-muq60cib/dev/types/**/*.ts",
    ".next-cms-e2e-webpack-muq62pdx/types/**/*.ts",
    ".next-cms-e2e-webpack-muq62pdx/dev/types/**/*.ts",
    ".next-cms-e2e-webpack-muq64uyr/types/**/*.ts",
    ".next-cms-e2e-webpack-muq64uyr/dev/types/**/*.ts",
    ".next-cms-e2e-webpack-muqym372/types/**/*.ts",
    ".next-cms-e2e-webpack-muqym372/dev/types/**/*.ts",
    ".next-cms-e2e-webpack-muqyujck/types/**/*.ts",
    ".next-cms-e2e-webpack-muqyujck/dev/types/**/*.ts",
    ".next-cms-e2e-webpack-muqz338b/types/**/*.ts",
    ".next-cms-e2e-webpack-muqz338b/dev/types/**/*.ts",
    ".next-cms-e2e-webpack-muqzjqg6/types/**/*.ts",
    ".next-cms-e2e-webpack-muqzjqg6/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "_header_rebuilt.tsx"
  ]
}
